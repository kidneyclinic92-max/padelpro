# Copy to .env in this folder (repo root). Server + Vite (admin UI) both read from here.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_API_KEY=

# Must match ADMIN_API_KEY (baked into admin UI at build time; optional if you enter key in /admin/bookings).
VITE_ADMIN_API_KEY=
VITE_ADMIN_PASSWORD=
# Leave empty when API is same origin (local dev + Azure).
VITE_API_BASE=
